---
type Language = 'fr' | 'en';
const { language, autoDetect = false } = Astro.props as { language: Language; autoDetect?: boolean };

const copy = {
  fr: {
    locale: 'fr-CA',
    title: 'Forge Nord — Projets numériques et créations locales',
    description: 'Forge Nord rassemble des projets numériques, des expériences NFC, des prototypes IoT et des créations locales au Canada.',
    navigation: 'Navigation principale',
    skip: 'Aller au contenu',
    projectsNav: 'Projets',
    aboutNav: 'À propos',
    languageLabel: 'Choisir la langue',
    eyebrow: 'Plateforme de projets · Canada',
    headlineStart: 'Des idées numériques,',
    headlineEnd: 'ancrées dans le réel.',
    heroText: 'Forge Nord réunit des expériences interactives, des prototypes et des outils conçus avec curiosité, précision et sens du terrain.',
    explore: 'Explorer les projets',
    heroNote: 'Imaginer. Fabriquer. Partager.',
    projectsEyebrow: '01 / Territoires d’exploration',
    projectsTitle: 'Des projets aux horizons variés.',
    projectsIntro: 'Quatre espaces en préparation, chacun avec sa propre direction et sa propre adresse.',
    soon: 'Bientôt',
    planned: 'Adresse prévue',
    projects: [
      { number: '01', name: 'NFC', category: 'Interaction', description: 'Des expériences et des jeux qui prennent vie au contact d’un objet.', domain: 'nfc.forgenord.ca' },
      { number: '02', name: 'Labs', category: 'Exploration', description: 'Un terrain d’essai pour les prototypes, l’IoT et les idées à éprouver.', domain: 'labs.forgenord.ca' },
      { number: '03', name: 'Portfolio', category: 'Parcours', description: 'Une sélection de réalisations, de savoir-faire et de méthodes de travail.', domain: 'portfolio.forgenord.ca' },
      { number: '04', name: 'Giocoso', category: 'Création', description: 'L’espace dédié aux projets de Giocoso Creation et aux idées ludiques.', domain: 'giocoso.forgenord.ca' },
    ],
    aboutEyebrow: '02 / À propos',
    aboutTitle: 'Une base commune pour créer librement.',
    aboutText: 'Forge Nord est le point de rencontre de projets indépendants qui mêlent numérique, objets et création. Chaque initiative évolue à son rythme; cette page en trace la carte.',
    footer: 'Fait au Canada',
    footerTop: 'Retour en haut',
  },
  en: {
    locale: 'en-CA',
    title: 'Forge Nord — Digital projects and local creations',
    description: 'Forge Nord brings together digital projects, NFC experiences, IoT prototypes, and local creations in Canada.',
    navigation: 'Main navigation',
    skip: 'Skip to content',
    projectsNav: 'Projects',
    aboutNav: 'About',
    languageLabel: 'Choose language',
    eyebrow: 'Project platform · Canada',
    headlineStart: 'Digital ideas,',
    headlineEnd: 'grounded in reality.',
    heroText: 'Forge Nord brings together interactive experiences, prototypes, and tools shaped by curiosity, precision, and practical thinking.',
    explore: 'Explore the projects',
    heroNote: 'Imagine. Build. Share.',
    projectsEyebrow: '01 / Areas of exploration',
    projectsTitle: 'Projects with different horizons.',
    projectsIntro: 'Four spaces in the making, each with its own direction and address.',
    soon: 'Coming soon',
    planned: 'Planned address',
    projects: [
      { number: '01', name: 'NFC', category: 'Interaction', description: 'Experiences and games that come to life through a physical touchpoint.', domain: 'nfc.forgenord.ca' },
      { number: '02', name: 'Labs', category: 'Exploration', description: 'A testing ground for prototypes, IoT, and ideas worth putting to work.', domain: 'labs.forgenord.ca' },
      { number: '03', name: 'Portfolio', category: 'Practice', description: 'A selection of work, capabilities, and ways of making things.', domain: 'portfolio.forgenord.ca' },
      { number: '04', name: 'Giocoso', category: 'Creation', description: 'A space for Giocoso Creation projects and playful ideas.', domain: 'giocoso.forgenord.ca' },
    ],
    aboutEyebrow: '02 / About',
    aboutTitle: 'A shared foundation for independent work.',
    aboutText: 'Forge Nord is a meeting point for independent projects across digital work, connected objects, and creative practice. Each initiative grows at its own pace; this page maps the way.',
    footer: 'Made in Canada',
    footerTop: 'Back to top',
  },
} as const;

const t = copy[language];
const currentPath = `/${language}/`;
---
<!doctype html>
<html lang={t.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1520" />
    <meta name="description" content={t.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://forgenord.ca${currentPath}`} />
    <link rel="alternate" hreflang="fr-CA" href="https://forgenord.ca/fr/" />
    <link rel="alternate" hreflang="en-CA" href="https://forgenord.ca/en/" />
    <link rel="alternate" hreflang="x-default" href="https://forgenord.ca/" />
    <title>{t.title}</title>
    {autoDetect && <script is:inline>
      (() => {
        let chosen;
        try { chosen = localStorage.getItem('forgenord:language'); } catch {}
        if (chosen !== 'fr' && chosen !== 'en') {
          const preferred = navigator.languages?.length ? navigator.languages : [navigator.language];
          chosen = preferred.find((locale) => /^(fr|en)(-|$)/i.test(locale))?.slice(0, 2).toLowerCase() || 'fr';
        }
        if (chosen === 'en') location.replace('/en/');
      })();
    </script>}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href={currentPath} aria-label="Forge Nord">
          <span class="brand-symbol" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
          <span class="brand-name">Forge<span>Nord</span></span>
        </a>
        <nav class="primary-nav" aria-label={t.navigation}>
          <a href="#projects">{t.projectsNav}</a>
          <a href="#about">{t.aboutNav}</a>
        </nav>
        <nav class="language-nav" aria-label={t.languageLabel}>
          <a href="/fr/" hreflang="fr-CA" lang="fr" aria-current={language === 'fr' ? 'page' : undefined} data-language-choice="fr">FR</a>
          <span aria-hidden="true">/</span>
          <a href="/en/" hreflang="en-CA" lang="en" aria-current={language === 'en' ? 'page' : undefined} data-language-choice="en">EN</a>
        </nav>
      </header>

      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <p class="eyebrow"><span class="eyebrow-line"></span>{t.eyebrow}</p>
            <h1 id="hero-title">{t.headlineStart}<br /><em>{t.headlineEnd}</em></h1>
            <p class="hero-description">{t.heroText}</p>
            <a class="text-link" href="#projects">{t.explore}<span aria-hidden="true">↗</span></a>
          </div>
          <div class="north-graphic" aria-hidden="true">
            <div class="graphic-orbit graphic-orbit-outer"></div>
            <div class="graphic-orbit graphic-orbit-inner"></div>
            <div class="graphic-axis graphic-axis-h"></div>
            <div class="graphic-axis graphic-axis-v"></div>
            <div class="graphic-core"><span>F</span><i></i><span>N</span></div>
            <span class="graphic-north">N</span>
            <span class="graphic-index">FN / 001</span>
          </div>
          <p class="hero-note">{t.heroNote}</p>
        </section>

        <section class="projects-section" id="projects" aria-labelledby="projects-title">
          <div class="section-heading">
            <div>
              <p class="section-label">{t.projectsEyebrow}</p>
              <h2 id="projects-title">{t.projectsTitle}</h2>
            </div>
            <p>{t.projectsIntro}</p>
          </div>
          <div class="project-grid">
            {t.projects.map((project) => (
              <article class="project-card">
                <div class="card-top"><span>{project.number} / {project.category}</span><span class="card-rule" aria-hidden="true"></span></div>
                <div class="card-main"><h3>{project.name}</h3><p>{project.description}</p></div>
                <div class="card-bottom"><span class="status"><span class="status-dot" aria-hidden="true"></span>{t.soon}</span><span class="domain" aria-label={`${t.planned}: ${project.domain}`}>{project.domain}</span></div>
              </article>
            ))}
          </div>
        </section>

        <section class="about-section" id="about" aria-labelledby="about-title">
          <p class="section-label">{t.aboutEyebrow}</p>
          <div class="about-content"><h2 id="about-title">{t.aboutTitle}</h2><p>{t.aboutText}</p></div>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Forge Nord</span>
        <span>{t.footer}</span>
        <a href="#top">forgenord.ca <span aria-hidden="true">↑</span><span class="sr-only">— {t.footerTop}</span></a>
      </footer>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-language-choice]').forEach((link) => {
        link.addEventListener('click', () => {
          try { localStorage.setItem('forgenord:language', link.dataset.languageChoice); } catch {}
        });
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #0b1520; color: #edf4f6; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  :global(:focus-visible) { outline: 2px solid #7fd5e0; outline-offset: 5px; }
  :global(::selection) { color: #07131b; background: #a6e7ed; }
  .skip-link { position: absolute; z-index: 5; top: 12px; left: 12px; padding: 12px 16px; background: #b9e6eb; color: #0b1520; font-size: 14px; font-weight: 700; transform: translateY(-150%); }
  .skip-link:focus { transform: translateY(0); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .site-shell { max-width: 1600px; min-height: 100vh; margin: 0 auto; padding: 0 clamp(24px, 5.5vw, 88px); overflow: hidden; }
  .site-header { min-height: 102px; display: flex; align-items: center; gap: 48px; border-bottom: 1px solid #29404c; }
  .brand { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; flex-shrink: 0; }
  .brand-name { font-size: 20px; font-weight: 690; letter-spacing: -.055em; }
  .brand-name span { margin-left: 4px; color: #a9dce4; }
  .brand-symbol { position: relative; display: block; width: 28px; height: 28px; transform: rotate(45deg); }
  .brand-symbol span { position: absolute; background: #b9e6eb; }
  .brand-symbol span:nth-child(1) { width: 11px; height: 11px; top: 0; left: 0; }
  .brand-symbol span:nth-child(2) { width: 11px; height: 11px; top: 0; right: 0; background: #376779; }
  .brand-symbol span:nth-child(3) { width: 11px; height: 11px; bottom: 0; left: 0; background: #376779; }
  .brand-symbol span:nth-child(4) { width: 11px; height: 11px; bottom: 0; right: 0; }
  .primary-nav { display: flex; gap: 34px; margin-left: auto; }
  .primary-nav a, .language-nav a { font-size: 12px; line-height: 1; font-weight: 600; letter-spacing: .09em; text-decoration: none; text-transform: uppercase; }
  .primary-nav a { color: #b0c0c8; transition: color .2s; }
  .primary-nav a:hover, .language-nav a:hover { color: #e8fcff; }
  .language-nav { display: flex; align-items: center; gap: 9px; padding-left: 32px; border-left: 1px solid #29404c; }
  .language-nav a { color: #79929e; }
  .language-nav a[aria-current="page"] { color: #d3f4f7; }
  .language-nav span { color: #50707d; font-size: 12px; }
  .hero { position: relative; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr); align-items: center; min-height: 645px; padding: 80px 0 110px; border-bottom: 1px solid #29404c; }
  .hero::before { position: absolute; inset: 0 -88px 0 auto; width: 54%; content: ""; pointer-events: none; background-image: linear-gradient(to right, #8acbd50b 1px, transparent 1px), linear-gradient(to bottom, #8acbd50b 1px, transparent 1px); background-size: 62px 62px; mask-image: linear-gradient(to right, transparent, #000 48%, transparent 98%); }
  .hero-copy { z-index: 1; max-width: 900px; }
  .eyebrow, .section-label { color: #83cbd4; font-size: 11px; font-weight: 700; letter-spacing: .19em; line-height: 1.5; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 14px; margin: 0 0 35px; }
  .eyebrow-line { width: 29px; height: 1px; background: #83cbd4; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { margin-bottom: 31px; font-size: clamp(52px, 5.2vw, 84px); font-weight: 590; letter-spacing: -.075em; line-height: 1.07; }
  h1 em { color: #9bd9e0; font-style: normal; }
  .hero-description { max-width: 570px; margin-bottom: 31px; color: #b8c8cf; font-size: clamp(16px, 1.55vw, 19px); line-height: 1.75; }
  .text-link { display: inline-flex; align-items: center; gap: 18px; padding: 0 0 10px; border-bottom: 1px solid #89cdd5; color: #e8f6f7; font-size: 13px; font-weight: 650; letter-spacing: .02em; text-decoration: none; }
  .text-link span { color: #9bd9e0; font-size: 19px; line-height: .8; transition: transform .2s; }
  .text-link:hover span { transform: translate(3px, -3px); }
  .north-graphic { position: relative; z-index: 0; width: min(100%, 405px); aspect-ratio: 1; margin: auto 0 auto auto; }
  .graphic-orbit { position: absolute; border: 1px solid #557786; border-radius: 50%; }
  .graphic-orbit-outer { inset: 4%; opacity: .62; }
  .graphic-orbit-outer::before, .graphic-orbit-outer::after { position: absolute; top: calc(50% - 3px); width: 6px; height: 6px; border: 1px solid #9bd9e0; border-radius: 50%; content: ""; }
  .graphic-orbit-outer::before { left: -3px; }
  .graphic-orbit-outer::after { right: -3px; }
  .graphic-orbit-inner { inset: 20%; border-color: #325361; }
  .graphic-axis { position: absolute; background: #335562; }
  .graphic-axis-h { top: 50%; left: 0; width: 100%; height: 1px; }
  .graphic-axis-v { top: 0; left: 50%; width: 1px; height: 100%; }
  .graphic-core { position: absolute; inset: 31%; display: flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid #83cbd4; background: #10232f; transform: rotate(45deg); box-shadow: 0 0 0 20px #0b1520; }
  .graphic-core span, .graphic-core i { transform: rotate(-45deg); }
  .graphic-core span { color: #d9f0f2; font-size: clamp(28px, 3vw, 48px); font-weight: 400; letter-spacing: -.08em; }
  .graphic-core i { width: 1px; height: 32px; background: #668d99; }
  .graphic-north, .graphic-index { position: absolute; color: #8fbcc5; font-size: 10px; font-weight: 700; letter-spacing: .16em; }
  .graphic-north { top: -9px; left: calc(50% - 4px); }
  .graphic-index { right: 4%; bottom: 1%; }
  .hero-note { position: absolute; right: 0; bottom: 32px; color: #8199a3; font-size: 11px; letter-spacing: .13em; text-transform: uppercase; }
  .projects-section { padding: 102px 0 118px; }
  .section-heading { display: grid; grid-template-columns: 1fr minmax(270px, 355px); align-items: end; gap: 64px; margin-bottom: 39px; }
  .section-label { margin-bottom: 22px; }
  h2 { max-width: 700px; margin-bottom: 0; font-size: clamp(36px, 4vw, 59px); font-weight: 560; letter-spacing: -.065em; line-height: 1.12; }
  .section-heading > p { margin-bottom: 2px; color: #9fb4bd; font-size: 15px; line-height: 1.7; }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .project-card { display: flex; flex-direction: column; min-height: 310px; padding: 27px 30px 25px; border: 1px solid #294551; background: linear-gradient(142deg, #142633 0%, #10202c 100%); }
  .card-top, .card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .card-top { color: #8fc1ca; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
  .card-rule { width: 24px; height: 1px; background: #6b95a0; }
  .card-main { padding: 35px 0 29px; }
  h3 { margin-bottom: 12px; font-size: clamp(30px, 3vw, 45px); font-weight: 570; letter-spacing: -.06em; line-height: 1; }
  .card-main p { max-width: 420px; margin-bottom: 0; color: #afc0c8; font-size: 14px; line-height: 1.68; }
  .card-bottom { margin-top: auto; padding-top: 18px; border-top: 1px solid #35515d; }
  .status { display: inline-flex; align-items: center; gap: 9px; color: #c6e6e9; font-size: 11px; font-weight: 700; letter-spacing: .055em; white-space: nowrap; }
  .status-dot { width: 6px; height: 6px; border: 1px solid #93d8df; border-radius: 50%; }
  .domain { color: #8199a3; font-size: 11px; white-space: nowrap; }
  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 50px; padding: 65px 0 112px; border-top: 1px solid #29404c; }
  .about-section .section-label { margin-top: 8px; }
  .about-content { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 50px; }
  .about-content h2 { font-size: clamp(32px, 3vw, 45px); }
  .about-content p { max-width: 420px; margin-bottom: 4px; color: #aebfc7; font-size: 15px; line-height: 1.75; }
  .site-footer { display: flex; align-items: center; justify-content: space-between; gap: 25px; min-height: 95px; border-top: 1px solid #29404c; color: #829ba5; font-size: 11px; letter-spacing: .04em; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: #d4f0f2; }
  .site-footer a span[aria-hidden] { margin-left: 10px; color: #9bd9e0; font-size: 16px; }
  @media (max-width: 1000px) {
    .hero { grid-template-columns: 1fr 290px; min-height: 570px; }
    .north-graphic { width: 290px; }
    .about-section { grid-template-columns: 1fr; gap: 8px; }
    .about-content { gap: 35px; }
  }
  @media (max-width: 720px) {
    .site-shell { padding: 0 22px; }
    .site-header { min-height: 82px; gap: 18px; flex-wrap: wrap; padding: 20px 0; }
    .brand-name { font-size: 19px; }
    .primary-nav { order: 3; width: 100%; margin: 7px 0 0; gap: 24px; }
    .language-nav { margin-left: auto; padding-left: 17px; }
    .hero { display: block; min-height: 0; padding: 84px 0 75px; }
    .hero::before { inset: 0 -22px 0 auto; width: 85%; }
    .hero-copy { position: relative; z-index: 1; }
    .eyebrow { margin-bottom: 27px; }
    h1 { font-size: clamp(48px, 10vw, 70px); }
    .hero-description { font-size: 16px; }
    .north-graphic { width: min(68vw, 260px); margin: 76px auto 28px; opacity: .8; }
    .hero-note { right: 0; bottom: 28px; }
    .projects-section { padding: 77px 0 88px; }
    .section-heading { display: block; margin-bottom: 30px; }
    .section-heading > p { max-width: 480px; margin: 22px 0 0; }
    .project-grid { grid-template-columns: 1fr; }
    .project-card { min-height: 275px; }
    .about-section { padding: 57px 0 78px; }
    .about-content { grid-template-columns: 1fr; gap: 18px; }
    .site-footer { flex-wrap: wrap; padding: 28px 0; min-height: 0; }
    .site-footer > span:nth-child(2) { display: none; }
  }
  @media (max-width: 400px) {
    .site-header { gap: 12px; }
    .brand-symbol { width: 22px; height: 22px; }
    .brand-symbol span { width: 9px !important; height: 9px !important; }
    .brand-name { font-size: 17px; }
    .project-card { padding: 23px 20px; }
    .card-bottom { align-items: flex-start; flex-direction: column; gap: 9px; }
    .hero-note { font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .text-link span, .primary-nav a { transition: none; }
  }
</style>
