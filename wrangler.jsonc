{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "forgenord-ca",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist"
  },
  "previews": {},
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "forgenord.ca",
      "custom_domain": true
    }
  ]
}
